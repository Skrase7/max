generator client {
  provider = "prisma-client"
  output   = "../database/generated/prisma" 
}

datasource db {
  provider = "postgresql"
   
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  isDone      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}